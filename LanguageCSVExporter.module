<?php

namespace ProcessWire;

/**
 * Language CSV Exporter
 *
 * Exports the translations of a selected module
 * for a selected language as a downloadable CSV file.
 *
 * @version 1.0.1
 * @license MIT
 */

class LanguageCSVExporter extends Process implements Module
{
    public static function getModuleInfo()
    {
        return [
            'title' => 'Language CSV Exporter',
            'version' => '1.0.1',
            'summary' => 'Exports module translations of a selected language as a downloadable CSV file.',
            'author' => 'Juergen Kern',
            'icon' => 'language',

            'requires' => [
                'ProcessWire>=3.0.264',
            ],

            'permission' => 'language-csv-exporter',

            // Created on install and removed on uninstall automatically
            // by the core (ModulesInstaller) - no own code needed.
            'permissions' => [
                'language-csv-exporter' => 'Use Language CSV Exporter',
            ],

            // Admin page is created/removed automatically by the inherited
            // Process::___install() / Process::___uninstall().
            'page' => [
                'name' => 'language-csv-exporter',
                'parent' => 'setup',
                'title' => 'Language CSV Exporter',
            ],
        ];
    }


    /**
     * Escape character for fgetcsv()/fputcsv()
     *
     * Passed explicitly (PHP 8.4 deprecates relying on the default) and
     * identical to the default used by LanguagePorter, so the written
     * CSV stays byte-compatible with the core's own export/import.
     */
    const CSV_ESCAPE = '\\';


    /**
     * Admin interface
     */
    public function execute()
    {

        $modules   = $this->wire()->modules;
        $languages = $this->wire()->languages;
        $input     = $this->wire()->input;

        /**
         * LanguageSupport required
         */
        if (!$languages) {
            throw new WireException(
                'LanguageSupport is not available on this ProcessWire installation.'
            );
        }


        /**
         * ---------------------------------------------------------
         * Form
         * ---------------------------------------------------------
         */

        $form = $modules->get('InputfieldForm');

        $form->method = 'post';
        $form->action = './';


        /**
         * ---------------------------------------------------------
         * Select module
         * ---------------------------------------------------------
         */

        $moduleField = $modules->get('InputfieldSelect');

        $moduleField->name = 'module';

        $moduleField->label = 'Module';

        $moduleField->description =
            'Select the module whose translations should be exported.';

        $moduleField->required = true;


        $moduleOptions = [];

        foreach ($modules->getModuleInfo('*') as $info) {

            if (empty($info['name'])) {
                continue;
            }

            $moduleName = $info['name'];

            /**
             * Show only installed modules
             */
            if (!$modules->isInstalled($moduleName)) {
                continue;
            }

            $title = !empty($info['title'])
                ? $info['title']
                : $moduleName;

            $moduleOptions[$moduleName] =
                $title . ' (' . $moduleName . ')';
        }


        asort(
            $moduleOptions,
            SORT_NATURAL | SORT_FLAG_CASE
        );


        foreach ($moduleOptions as $name => $title) {

            $moduleField->addOption(
                $name,
                $title
            );
        }


        $form->add($moduleField);


        /**
         * ---------------------------------------------------------
         * Select language
         * ---------------------------------------------------------
         */

        $languageField = $modules->get('InputfieldSelect');

        $languageField->name = 'language';

        $languageField->label = 'Language';

        $languageField->description =
            'Select the language for which the translations should be exported.';

        $languageField->required = true;


        foreach ($languages as $language) {

            $languageField->addOption(
                $language->name,
                $language->title . ' (' . $language->name . ')'
            );
        }


        $form->add($languageField);


        /**
         * ---------------------------------------------------------
         * Submit
         * ---------------------------------------------------------
         */

        $submit = $modules->get('InputfieldSubmit');

        $submit->name = 'export_language_csv';

        $submit->label =
            'Download translations as CSV';

        $submit->icon = 'download';


        $form->add($submit);


        /**
         * ---------------------------------------------------------
         * Form submission
         * ---------------------------------------------------------
         *
         * All errors (including CSRF errors thrown by processInput())
         * are caught here and shown as a notice, so the form is still
         * rendered below instead of an empty admin page.
         */

        if ($input->post->export_language_csv) {

            try {

                $this->processExport($form);

            } catch (WireException $e) {

                $this->error($e->getMessage());
            }
        }


        /**
         * ---------------------------------------------------------
         * Output
         * ---------------------------------------------------------
         */

        $out = '';

        $out .= '<p>';
        $out .=
            'Select a module and a language. ';
        $out .=
            'The translations will be exported as a ProcessWire CSV ';
        $out .=
            'and then downloaded directly as a CSV file.';
        $out .= '</p>';

        $out .= $form->render();

        return $out;
    }


    /**
     * Process the submitted form and send the CSV download
     *
     * Does not return on success (the download ends the request).
     *
     * @param InputfieldForm $form
     * @return void
     * @throws WireException
     */
    protected function processExport(InputfieldForm $form)
    {

        $modules   = $this->wire()->modules;
        $languages = $this->wire()->languages;

        /**
         * ProcessWire handles CSRF checking here.
         */
        $form->processInput($this->wire()->input->post);

        if ($form->getErrors()) {
            return;
        }

        $moduleName =
            (string) $form->getChildByName('module')->value;

        $languageName =
            (string) $form->getChildByName('language')->value;


        /**
         * Check module
         *
         * The module is intentionally NOT loaded/instantiated - only its
         * name and file location are needed, and loading a foreign module
         * would run its init() with possible side effects.
         */
        if ($moduleName === '' || !$modules->isInstalled($moduleName)) {

            throw new WireException(
                'The selected module is not installed.'
            );
        }


        /**
         * Load language
         */
        $language = $languages->get($languageName);

        if (!$language || !$language->id) {

            throw new WireException(
                'The selected language was not found.'
            );
        }


        /**
         * Generate CSV export in memory
         */
        $csv = $this->createCsvExport(
            $moduleName,
            $language
        );


        /**
         * Download CSV
         */
        $filename =
            $this->sanitizeFilename($moduleName) .
            '-' .
            $this->sanitizeFilename($language->name) .
            '-translations.csv';

        $this->downloadCsv(
            $csv,
            $filename
        );
    }


    /**
     * Generate the module's translation export as a CSV string
     *
     * @param string $moduleName
     * @param Language $language
     * @return string CSV data (header + at least one row)
     * @throws WireException
     */
    protected function createCsvExport(
        $moduleName,
        Language $language
    ) {
        /**
         * LanguagePorter available?
         */
        $porter = $language->porter;

        if (!$porter) {

            throw new WireException(
                'LanguagePorter could not be loaded.'
            );
        }


        /**
         * ---------------------------------------------------------
         * Determine module file, directory and export source
         * ---------------------------------------------------------
         *
         * Example:
         *
         * /var/www/html/site/modules/FrontendForms/FrontendForms.module.php
         *
         * becomes the source:
         *
         * site/modules/FrontendForms
         */

        $rootPath = $this->rootPath();

        $moduleFile =
            $this->wire()->modules->getModuleFile(
                $moduleName
            );

        if (!$moduleFile || !is_file($moduleFile)) {

            throw new WireException(
                'The module file could not be determined.'
            );
        }

        $moduleFile      = $this->normalizePath($moduleFile);
        $moduleDirectory = dirname($moduleFile);

        if (strpos($moduleDirectory . '/', $rootPath) !== 0) {

            throw new WireException(
                'The module file is located outside of the ProcessWire root directory.'
            );
        }

        $source = trim(
            substr($moduleDirectory, strlen($rootPath)),
            '/'
        );


        /**
         * ---------------------------------------------------------
         * Export CSV (in memory)
         * ---------------------------------------------------------
         *
         * registered = translation files that already exist for this
         * language. 'exportTo' => 'string' avoids writing a temporary
         * (and unfiltered) CSV file into the publicly accessible
         * site/assets/files/ directory of the language page.
         *
         * exportCsv() throws a WireException if there are no registered
         * translation files at all for the source - it is replaced by a
         * more helpful message here.
         */

        $notFoundMessage =
            'No translations were found for the module "' .
            $moduleName .
            '" in the language "' .
            $language->title .
            '". Open the module\'s files at least once in ' .
            'Setup > Languages > ' . $language->title .
            ' > Translate files, so they are registered for this language.';

        try {

            $csv = $porter->exportCsv([
                'source'   => $source,
                'scope'    => 'registered',
                'exportTo' => 'string',
            ]);

        } catch (WireException $e) {

            throw new WireException($notFoundMessage);
        }

        if (!is_string($csv) || $csv === '') {

            throw new WireException($notFoundMessage);
        }


        /**
         * ---------------------------------------------------------
         * Restrict CSV to the files that belong to this module
         * ---------------------------------------------------------
         *
         * 'source' in exportCsv() is only a directory prefix filter.
         * If several modules live in the same folder (e.g.
         * FrontendForms.module and FrontendFormsManager.module in
         * site/modules/FrontendForms/), or in subfolders of it, the
         * translations of ALL of them end up in the exported CSV.
         * See getFileOwnershipRules() for how this is resolved.
         */

        $rules = $this->getFileOwnershipRules(
            $moduleName,
            $moduleFile,
            $moduleDirectory
        );

        $numRows = 0;

        $csv = $this->filterCsv(
            $csv,
            function ($file) use ($rules) {
                return $this->fileBelongsToModule($file, $rules);
            },
            $numRows
        );

        if (!$numRows) {

            throw new WireException($notFoundMessage);
        }

        return $csv;
    }


    /**
     * Determine which source files belong to the selected module
     *
     * All modules (installed or not) whose file lives inside the
     * selected module's directory - directly or in any subdirectory -
     * are taken into account:
     *
     * - Modules in a SUBDIRECTORY own that whole subdirectory, so it is
     *   always excluded (it would be exported separately via that module).
     * - Among the modules DIRECTLY in the same directory, one "primary"
     *   module is determined (see findPrimaryModule()). The primary
     *   module gets every file in the directory except the other modules'
     *   own files and subdirectories. Every other ("guest") module gets
     *   only its own module file.
     *
     * @param string $moduleName
     * @param string $moduleFile Normalized absolute path
     * @param string $moduleDirectory Normalized absolute path (no trailing slash)
     * @return array [
     *   'ownFile' => root-relative module file,
     *   'isPrimary' => bool,
     *   'excludedFiles' => [root-relative file => true],
     *   'excludedDirectories' => [root-relative dir with trailing slash, ...],
     * ]
     */
    protected function getFileOwnershipRules(
        $moduleName,
        $moduleFile,
        $moduleDirectory
    ) {

        $rootPath = $this->rootPath();

        $sameDirectoryModules = [];   // className => absolute file
        $excludedFiles        = [];
        $excludedDirectories  = [];

        foreach ($this->getAllModuleFiles() as $otherName => $otherFile) {

            if (strpos($otherFile, $moduleDirectory . '/') !== 0) {
                continue; // not inside the module's directory
            }

            $otherDirectory = dirname($otherFile);

            if ($otherDirectory === $moduleDirectory) {

                $sameDirectoryModules[$otherName] = $otherFile;
                continue;
            }

            // module in a subdirectory: owns its whole directory
            $excludedDirectories[] =
                substr($otherDirectory, strlen($rootPath)) . '/';
        }

        // make sure the selected module itself is part of the list
        $sameDirectoryModules[$moduleName] = $moduleFile;

        $primaryModule = $this->findPrimaryModule(
            basename($moduleDirectory),
            array_keys($sameDirectoryModules)
        );

        $isPrimary = ($primaryModule === $moduleName);

        foreach ($sameDirectoryModules as $otherName => $otherFile) {

            if ($otherName === $moduleName) {
                continue;
            }

            $excludedFiles[substr($otherFile, strlen($rootPath))] = true;
        }

        if ($primaryModule === null && count($sameDirectoryModules) > 1) {

            // stored in the session: the download ends the current
            // request, so a normal notice would never be displayed
            $this->wire()->session->warning(
                'Several modules share the folder "' .
                basename($moduleDirectory) .
                '" and none of them could be identified as the main module. ' .
                'Only the translations of the module file itself were exported; ' .
                'translations of shared supporting files are not included.'
            );
        }

        return [
            'ownFile'             => substr($moduleFile, strlen($rootPath)),
            'isPrimary'           => $isPrimary,
            'excludedFiles'       => $excludedFiles,
            'excludedDirectories' => array_unique($excludedDirectories),
        ];
    }


    /**
     * Find the "primary" module among modules sharing one directory
     *
     * The primary module owns the directory's supporting files. Checks,
     * in this order:
     *
     * 1. Only one module in the directory -> it is primary.
     * 2. Directory name equals a class name (case-insensitive).
     * 3. Directory name starts with a class name, e.g. a GitHub download
     *    "FrontendForms-main" -> "FrontendForms" (longest match wins).
     * 4. One class name is the prefix of all other class names, e.g.
     *    "FrontendForms" for "FrontendFormsManager".
     *
     * @param string $directoryName Basename of the directory
     * @param array $classNames Class names of all modules in it
     * @return string|null Class name of the primary module or null if none
     */
    protected function findPrimaryModule(
        $directoryName,
        array $classNames
    ) {

        if (count($classNames) === 1) {
            return reset($classNames);
        }

        $directoryLower = strtolower($directoryName);

        foreach ($classNames as $className) {

            if (strtolower($className) === $directoryLower) {
                return $className;
            }
        }

        $best = null;

        foreach ($classNames as $className) {

            $classLower = strtolower($className);

            if (
                strpos($directoryLower, $classLower) === 0 &&
                ($best === null || strlen($className) > strlen($best))
            ) {
                $best = $className;
            }
        }

        if ($best !== null) {
            return $best;
        }

        foreach ($classNames as $candidate) {

            $isPrefixOfAll = true;

            foreach ($classNames as $className) {

                if (
                    $className !== $candidate &&
                    stripos($className, $candidate) !== 0
                ) {
                    $isPrefixOfAll = false;
                    break;
                }
            }

            if ($isPrefixOfAll) {
                return $candidate;
            }
        }

        return null;
    }


    /**
     * Does the given source file belong to the selected module?
     *
     * @param string $file Root-relative file from the CSV "file" column
     * @param array $rules As returned by getFileOwnershipRules()
     * @return bool
     */
    protected function fileBelongsToModule($file, array $rules)
    {

        $file = ltrim($this->normalizePath($file), '/');

        if ($file === $rules['ownFile']) {
            return true;
        }

        if (!$rules['isPrimary']) {
            return false;
        }

        if (isset($rules['excludedFiles'][$file])) {
            return false;
        }

        foreach ($rules['excludedDirectories'] as $directory) {

            if (strpos($file, $directory) === 0) {
                return false;
            }
        }

        return true;
    }


    /**
     * Get the files of all known modules (installed and uninstalled)
     *
     * @return array [className => normalized absolute file]
     */
    protected function getAllModuleFiles()
    {

        $modules = $this->wire()->modules;

        $files = [];

        // uninstalled modules that are present in the file system
        foreach ($modules->getInstallable() as $className => $file) {

            if ($file) {
                $files[$className] = $this->normalizePath($file);
            }
        }

        // installed modules
        foreach ($modules->getModuleInfo('*') as $info) {

            if (empty($info['name']) || isset($files[$info['name']])) {
                continue;
            }

            $file = $modules->getModuleFile($info['name']);

            if ($file) {
                $files[$info['name']] = $this->normalizePath($file);
            }
        }

        return $files;
    }


    /**
     * Filter the rows of a CSV string by their "file" column
     *
     * @param string $csv CSV as generated by LanguagePorter::exportCsv()
     * @param callable $keepFile function(string $file): bool
     * @param int $numRows Receives the number of data rows kept
     * @return string Filtered CSV (header row is always kept)
     * @throws WireException
     */
    protected function filterCsv(
        $csv,
        callable $keepFile,
        &$numRows = 0
    ) {

        $numRows = 0;

        $in  = fopen('php://temp', 'r+');
        $out = fopen('php://temp', 'r+');

        if (!$in || !$out) {

            throw new WireException(
                'The CSV data could not be processed.'
            );
        }

        fwrite($in, $csv);
        rewind($in);

        $header = fgetcsv($in, 0, ',', '"', self::CSV_ESCAPE);

        if (!is_array($header)) {

            fclose($in);
            fclose($out);
            return '';
        }

        $fileColumnIndex = array_search('file', $header, true);

        if ($fileColumnIndex === false) {

            fclose($in);
            fclose($out);

            throw new WireException(
                'The exported CSV has no "file" column - ' .
                'the translations cannot be assigned to the module.'
            );
        }

        fputcsv($out, $header, ',', '"', self::CSV_ESCAPE);

        while (($row = fgetcsv($in, 0, ',', '"', self::CSV_ESCAPE)) !== false) {

            // skip blank lines (fgetcsv returns [null])
            if ($row === [null]) {
                continue;
            }

            $rowFile = isset($row[$fileColumnIndex])
                ? (string) $row[$fileColumnIndex]
                : '';

            if ($rowFile === '' || !$keepFile($rowFile)) {
                continue;
            }

            fputcsv($out, $row, ',', '"', self::CSV_ESCAPE);
            $numRows++;
        }

        fclose($in);

        rewind($out);
        $result = stream_get_contents($out);
        fclose($out);

        return (string) $result;
    }


    /**
     * Send CSV data to the browser as a download
     *
     * Sent directly from memory - no temporary file is left behind.
     * Ends the current request.
     *
     * @param string $csv
     * @param string $filename
     * @return void
     */
    protected function downloadCsv($csv, $filename)
    {

        $this->wire()->files->send(
            false,
            [
                'data' => $csv,
                'forceDownload' => true,
                'downloadFilename' => $filename,
                'exit' => true,
            ]
        );
    }


    /**
     * ProcessWire root path, normalized, with trailing slash
     *
     * @return string
     */
    protected function rootPath()
    {

        return rtrim(
            $this->normalizePath($this->wire()->config->paths->root),
            '/'
        ) . '/';
    }


    /**
     * Normalize a path to forward slashes
     *
     * @param string $path
     * @return string
     */
    protected function normalizePath($path)
    {

        return str_replace('\\', '/', (string) $path);
    }


    /**
     * Sanitize filename
     *
     * @param string $value
     * @return string
     */
    protected function sanitizeFilename($value)
    {

        $value =
            preg_replace(
                '/[^a-zA-Z0-9._-]+/',
                '-',
                $value
            );


        $value =
            trim(
                $value,
                '-.'
            );


        return $value ?: 'export';
    }
}
